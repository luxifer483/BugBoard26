{
  "name": "bugboard26-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API BugBoard26 con Express, Sequelize e PostgreSQL",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "c8 --all --include=\"src/**/*.js\" --reporter=text --reporter=lcov --reporter=json qunit \"test/**/*.test.js\"",
    "test:unit": "c8 --all --include=\"src/**/*.js\" --reports-dir=coverage-unit --reporter=text --reporter=lcov --reporter=json qunit \"test/unit/**/*.test.js\"",
    "test:integration": "c8 --all --include=\"src/**/*.js\" --reports-dir=coverage-integration --reporter=text --reporter=lcov --reporter=json qunit \"test/integration/**/*.test.js\""
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "qunit": "^2.26.0"
  }
}
